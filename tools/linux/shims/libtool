# A Linux stand-in for a command build-ipa.yml expects on a Mac (tools/linux/run-workflow.py).
# Apple's libtool is used as "libtool -static -o OUT.a IN...": llvm-libtool-darwin does that. Anything else
# is GNU libtool's.
case " $* " in
    *" -static "*) exec /usr/lib/llvm-18/bin/llvm-libtool-darwin "$@" ;;
    *) . "$(dirname "$0")/_env.sh"; exec env PATH="$(bcd_real_path)" libtool "$@" ;;
esac
