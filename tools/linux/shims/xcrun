# A Linux stand-in for a command build-ipa.yml expects on a Mac (tools/linux/run-workflow.py).
# xcrun: --show-sdk-path, --show-sdk-version, --find, and "run this tool for that SDK".
. "$(dirname "$0")/_env.sh"
sdk=${SDKROOT:-iphoneos}; action=run
while [ $# -gt 0 ]; do
    case $1 in
        --sdk|-sdk) sdk=$2; shift 2 ;;
        --toolchain|-toolchain) shift 2 ;;
        --show-sdk-path|-show-sdk-path) action=path; shift ;;
        --show-sdk-version|-show-sdk-version) action=version; shift ;;
        --show-sdk-platform-path|-show-sdk-platform-path) action=platform; shift ;;
        --show-sdk-platform-version|-show-sdk-platform-version) action=version; shift ;;
        --find|-find|-f) action=find; shift ;;
        --run|-run|-r) shift ;;
        -*) echo "xcrun stand-in: option $1 is not handled" >&2; exit 64 ;;
        *) break ;;
    esac
done
case $action in
    path) bcd_sdk_path "$sdk"; exit ;;
    version) bcd_sdk_version "$sdk"; exit ;;
    platform) dirname "$(dirname "$(dirname "$(bcd_sdk_path "$sdk")")")"; exit ;;
    find) command -v "$1"; exit ;;
esac
[ $# -gt 0 ] || { echo "xcrun stand-in: nothing to run" >&2; exit 64; }
tool=$1; shift
case $tool in
    metal-ar|actool|ibtool|simctl|altool|notarytool|momc|xcstringstool)
        echo "xcrun stand-in: Apple's '$tool' exists only on a Mac; this step cannot run on Linux as written" >&2; exit 78 ;;
esac
SDKROOT=$(bcd_sdk_path "$sdk") BCD_XCRUN_SDK=$sdk exec "$tool" "$@"
