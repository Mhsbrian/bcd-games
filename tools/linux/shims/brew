# A Linux stand-in for a command build-ipa.yml expects on a Mac (tools/linux/run-workflow.py).
# Homebrew: the image already holds what the workflow installs with it.
case ${1:-} in
    --prefix) case ${2:-} in llvm|lld|llvm@*) echo /opt/bcd-llvm ;; *) echo /usr ;; esac ;;
    install|update|upgrade|link|unlink|tap|reinstall) echo "brew stand-in: '$*' (already in the image, nothing done)" ;;
    list|ls) exit 0 ;;
    *) echo "brew stand-in: '$*' is not handled" >&2; exit 64 ;;
esac
